# ==========================================
# Türkiye Deprem İzleme - Production Environment
# ==========================================

# Domain and Hostname (e.g. depremizleme.com or www.depremizleme.com)
DOMAIN_NAME=depremizleme.com
CORS_ALLOWED_ORIGINS=https://depremizleme.com,https://www.depremizleme.com

# PostgreSQL Database Configuration
POSTGRES_DB=depremdb
POSTGRES_USER=deprem_app
POSTGRES_PASSWORD=Guvendi_Parola_Buraya_Yaziniz_123!
POSTGRES_PORT=5432

# Spring Boot App Configuration
PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/depremdb
SPRING_DATASOURCE_USERNAME=deprem_app
SPRING_DATASOURCE_PASSWORD=Guvendi_Parola_Buraya_Yaziniz_123!

# AFAD Poller Settings
AFAD_SYNC_ENABLED=true
AFAD_SYNC_INTERVAL_MS=300000
AFAD_SYNC_WINDOW_HOURS=24

# Retention & Cleanup (Automatically retain 30 days of active data)
APP_RETENTION_ENABLED=true
APP_RETENTION_DAYS=30
APP_ARCHIVE_AUTO_EXPORT=true

# Admin API Key (For secured management endpoints)
APP_ADMIN_API_KEY=gizli-yonetici-anahtari-buraya-belirleyin
